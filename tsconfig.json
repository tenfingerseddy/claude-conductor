{
  // Editor and `tsc --noEmit` only. Node 24 runs the TypeScript directly by stripping types,
  // so there is no build step and nothing here may emit or transform.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "noEmit": true,
    // Node strips types, it does not rewrite them, so imports keep their .ts extensions and
    // every construct must be erasable (no enums, no parameter properties, no namespaces).
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
